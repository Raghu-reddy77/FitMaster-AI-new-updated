# Backend Node.js Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fitmaster_ai
DB_CONNECTION_LIMIT=10

# JWT Authentication
JWT_SECRET=fitmaster_super_secret_jwt_key_2026_academic_project
JWT_EXPIRES_IN=7d

# Python AI Service Communication
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=10000

# Google Gemini Nutrition Assistant (server-side only; never use in frontend)
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
